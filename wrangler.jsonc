{
  "$schema": "https://developers.cloudflare.com/workers/wrangler/config-schema.json",
  "name": "drive-tv-player",
  "main": "./worker.js",
  "compatibility_date": "2026-11-14",
  "durable_objects": {
    "bindings": [
      { "name": "PROBE_LOG_STORE", "class_name": "ProbeLogStore" }
    ]
  },
  "migrations": [
    { "tag": "v1-probe-log-store", "new_sqlite_classes": ["ProbeLogStore"] }
  ],
  "kv_namespaces": [
    {
      "binding": "PROBE_LOGS",
      "id": "02b9337f285f42ee89776d67836a3dc7"
    }
  ],
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  }
}
